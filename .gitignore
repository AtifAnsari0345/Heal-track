# Ignore ALL node_modules folders (root + backend)
node_modules/
backend/node_modules/

# Ignore environment variables
backend/.env

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore system/IDE files
.DS_Store
.vscode/
Thumbs.db

# Optional: ignore stackdump files
*.stackdump
